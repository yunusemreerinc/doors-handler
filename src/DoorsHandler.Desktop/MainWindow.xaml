<Window x:Class="DoorsHandler.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:DoorsHandler.Desktop.Converters"
        Title="DOORS Handler — Module List"
        Icon="Assets/AppIcon.ico"
        Width="1100" Height="700" MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
    <Window.Resources>
        <conv:ItemTypeLabelConverter x:Key="TypeLabel" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- connection -->
            <RowDefinition Height="Auto" />  <!-- root folder -->
            <RowDefinition Height="Auto" />  <!-- filter -->
            <RowDefinition Height="*" />     <!-- module list -->
            <RowDefinition Height="Auto" />  <!-- warnings -->
            <RowDefinition Height="Auto" />  <!-- error banner -->
            <RowDefinition Height="Auto" />  <!-- status bar -->
        </Grid.RowDefinitions>

        <!-- Connection -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,0,0,1" Padding="8">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Left" Text="Connection:" Style="{StaticResource BarLabel}" />
                <ComboBox DockPanel.Dock="Left" Width="230"
                          ItemsSource="{Binding ConnectionModes}"
                          SelectedItem="{Binding SelectedMode}"
                          IsEnabled="{Binding CanChangeMode}" />
                <Button DockPanel.Dock="Left" Content="Connect" Style="{StaticResource PrimaryButton}"
                        Command="{Binding ConnectCommand}" />
                <Button DockPanel.Dock="Left" Content="Disconnect" Command="{Binding DisconnectCommand}" />

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="16,0,0,0">
                    <TextBlock Text="Theme:" Style="{StaticResource BarLabel}" />
                    <ComboBox Width="90" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Margin="4,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource StatusOffBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource StatusOnBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding SessionText}" VerticalAlignment="Center" Margin="2,0,4,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Where to list -->
        <DockPanel Grid.Row="1" Margin="8,8,8,4" LastChildFill="True">
            <TextBlock DockPanel.Dock="Left" Text="Root folder:" Style="{StaticResource BarLabel}" />
            <Button DockPanel.Dock="Left" Content="↑" ToolTip="Go up one folder" Padding="8,2"
                    Command="{Binding GoUpCommand}" />
            <Button DockPanel.Dock="Right" Content="Cancel" Command="{Binding CancelCommand}"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <Button DockPanel.Dock="Right" Content="List modules" Style="{StaticResource PrimaryButton}"
                    Command="{Binding ListCommand}" />
            <CheckBox DockPanel.Dock="Right" Content="Include subfolders" IsChecked="{Binding Recursive}" />
            <TextBox x:Name="RootPathBox" Text="{Binding RootPath, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="e.g. /Project Name/Requirements — use / for the whole database">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding ListCommand}" />
                </TextBox.InputBindings>
            </TextBox>
        </DockPanel>

        <!-- Filter -->
        <DockPanel Grid.Row="2" Margin="8,4,8,8" LastChildFill="True">
            <TextBlock DockPanel.Dock="Left" Text="Show:" Style="{StaticResource BarLabel}" />
            <ComboBox DockPanel.Dock="Left" Width="190"
                      ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}" />
            <Button DockPanel.Dock="Right" Content="{Binding ExportJsonText}" Command="{Binding ExportJsonCommand}"
                    ToolTip="Reads every object (heading, text, attributes) of the selected formal modules from DOORS and writes them to one JSON file. Use Ctrl or Shift to select several modules." />
            <Button DockPanel.Dock="Right" Content="Export list to CSV…" Command="{Binding ExportCommand}" />
            <Grid Margin="0">
                <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Search name, path, description or ID…" IsHitTestVisible="False"
                           Margin="12,0" VerticalAlignment="Center" Foreground="{DynamicResource PlaceholderBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FilterText}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DockPanel>

        <!-- Items -->
        <Grid Grid.Row="3" Margin="8,0,8,8">
            <DataGrid x:Name="ItemsGrid"
                      ItemsSource="{Binding ItemsView}"
                      SelectedItem="{Binding SelectedItem}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Extended" SelectionUnit="FullRow"
                      SelectionChanged="OnSelectionChanged"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      RowHeight="26"
                      MouseDoubleClick="OnItemDoubleClick">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Copy full path" Command="{Binding CopyPathCommand}" />
                        <MenuItem Header="List this folder/project" Command="{Binding BrowseIntoCommand}" />
                        <Separator />
                        <MenuItem Header="{Binding ExportJsonText}" Command="{Binding ExportJsonCommand}" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Type" Width="120" SortMemberPath="Type"
                                        Binding="{Binding Type, Converter={StaticResource TypeLabel}}" />
                    <DataGridTextColumn Header="Name" Width="2*" Binding="{Binding Name}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Location" Width="3*" Binding="{Binding ParentPath}" SortMemberPath="FullName" />
                    <DataGridTextColumn Header="Description" Width="2*" Binding="{Binding Description}" />
                    <DataGridTextColumn Header="Unique ID" Width="110" Binding="{Binding UniqueId}" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"
                       TextAlignment="Center" IsHitTestVisible="False"
                       Text="No modules listed yet.&#x0a;Connect to DOORS and the list will load automatically.">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Items.Count}" Value="0" />
                                    <Condition Binding="{Binding IsBusy}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <ProgressBar IsIndeterminate="True" Height="4" VerticalAlignment="Top"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
        </Grid>

        <!-- Warnings -->
        <Expander Grid.Row="4" Margin="8,0,8,8"
                  Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibility}}">
            <Expander.Header>
                <TextBlock Foreground="{DynamicResource WarningTextBrush}">
                    <Run Text="⚠ DOORS warnings (" /><Run Text="{Binding Warnings.Count, Mode=OneWay}" /><Run Text=")" />
                </TextBlock>
            </Expander.Header>
            <ListBox ItemsSource="{Binding Warnings}" MaxHeight="120" BorderThickness="0" />
        </Expander>

        <!-- Error report: what failed, why, and what to do. Placed at the bottom so the
             controls above don't move when it appears; only the module list gets shorter. -->
        <Border Grid.Row="5" Background="{DynamicResource ErrorBackgroundBrush}" BorderBrush="{DynamicResource ErrorBorderBrush}" BorderThickness="0,1,0,0" Padding="12,10"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"
                AutomationProperties.LiveSetting="Assertive">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Content="Retry" Style="{StaticResource PrimaryButton}" Command="{Binding RetryCommand}" />
                    <Button Content="Copy details" Command="{Binding CopyErrorCommand}"
                            ToolTip="Copies the error details to the clipboard so you can send them to your support team" />
                    <Button Content="✕" Padding="8,2" ToolTip="Close" Command="{Binding DismissErrorCommand}" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Left" Text="⛔" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Top" />
                <StackPanel>
                    <TextBlock Text="{Binding Error.Title}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource ErrorTextBrush}" />
                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,0">
                        <Run Text="Reason: " FontWeight="SemiBold" /><Run Text="{Binding Error.Reason, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,0">
                        <Run Text="What you can do: " FontWeight="SemiBold" /><Run Text="{Binding Error.Suggestion, Mode=OneWay}" />
                    </TextBlock>
                    <Expander Header="Technical details" Margin="0,6,0,0" Foreground="{DynamicResource MutedBrush}">
                        <TextBox Text="{Binding Error.Details, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                 FontFamily="Consolas" FontSize="12" Margin="0,4,0,0" Padding="4"
                                 MaxHeight="140" VerticalScrollBarVisibility="Auto" />
                    </Expander>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Status -->
        <StatusBar Grid.Row="6" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
                   BorderThickness="0,1,0,0">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel LastChildFill="True" />
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock Text="{Binding CountText}" Foreground="{DynamicResource MutedBrush}" />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
