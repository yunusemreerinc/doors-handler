<Window x:Class="DoorsHandler.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:DoorsHandler.Desktop.Converters"
        Title="DOORS Handler — Modül Listesi"
        Width="1100" Height="700" MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <conv:ItemTypeLabelConverter x:Key="TypeLabel" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Connection -->
        <Border Grid.Row="0" Background="{StaticResource BarBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="8">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Left" Text="Bağlantı:" Style="{StaticResource BarLabel}" />
                <ComboBox DockPanel.Dock="Left" Width="230"
                          ItemsSource="{Binding ConnectionModes}"
                          SelectedItem="{Binding SelectedMode}"
                          IsEnabled="{Binding CanChangeMode}" />
                <Button DockPanel.Dock="Left" Content="Bağlan" Style="{StaticResource PrimaryButton}"
                        Command="{Binding ConnectCommand}" />
                <Button DockPanel.Dock="Left" Content="Bağlantıyı kes" Command="{Binding DisconnectCommand}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Margin="4,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#B0B7C3" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="#2E9D57" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding SessionText}" VerticalAlignment="Center" Margin="2,0,4,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Error report: what failed, why, and what to do -->
        <Border Grid.Row="1" Background="#FDF0F0" BorderBrush="#E8B4B4" BorderThickness="0,0,0,1" Padding="12,10"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"
                AutomationProperties.LiveSetting="Assertive">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Content="Tekrar dene" Style="{StaticResource PrimaryButton}" Command="{Binding RetryCommand}" />
                    <Button Content="Ayrıntıları kopyala" Command="{Binding CopyErrorCommand}"
                            ToolTip="Hata bilgilerini destek ekibine göndermek için panoya kopyalar" />
                    <Button Content="✕" Padding="8,2" ToolTip="Kapat" Command="{Binding DismissErrorCommand}" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Left" Text="⛔" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Top" />
                <StackPanel>
                    <TextBlock Text="{Binding Error.Title}" FontWeight="Bold" FontSize="14" Foreground="#9B1C1C" />
                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,0">
                        <Run Text="Neden: " FontWeight="SemiBold" /><Run Text="{Binding Error.Reason, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,0">
                        <Run Text="Ne yapabilirsiniz: " FontWeight="SemiBold" /><Run Text="{Binding Error.Suggestion, Mode=OneWay}" />
                    </TextBlock>
                    <Expander Header="Teknik ayrıntılar" Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}">
                        <TextBox Text="{Binding Error.Details, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                 FontFamily="Consolas" FontSize="12" Margin="0,4,0,0" Padding="4"
                                 MaxHeight="140" VerticalScrollBarVisibility="Auto" />
                    </Expander>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Where to list -->
        <DockPanel Grid.Row="2" Margin="8,8,8,4" LastChildFill="True">
            <TextBlock DockPanel.Dock="Left" Text="Kök klasör:" Style="{StaticResource BarLabel}" />
            <Button DockPanel.Dock="Left" Content="↑" ToolTip="Üst klasöre çık" Padding="8,2"
                    Command="{Binding GoUpCommand}" />
            <Button DockPanel.Dock="Right" Content="İptal" Command="{Binding CancelCommand}"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <Button DockPanel.Dock="Right" Content="Modülleri listele" Style="{StaticResource PrimaryButton}"
                    Command="{Binding ListCommand}" />
            <CheckBox DockPanel.Dock="Right" Content="Alt klasörleri de tara" IsChecked="{Binding Recursive}" />
            <TextBox x:Name="RootPathBox" Text="{Binding RootPath, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Örn. /Proje Adı/Gereksinimler — veritabanının tamamı için /">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding ListCommand}" />
                </TextBox.InputBindings>
            </TextBox>
        </DockPanel>

        <!-- Filter -->
        <DockPanel Grid.Row="3" Margin="8,4,8,8" LastChildFill="True">
            <TextBlock DockPanel.Dock="Left" Text="Göster:" Style="{StaticResource BarLabel}" />
            <ComboBox DockPanel.Dock="Left" Width="190"
                      ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}" />
            <Button DockPanel.Dock="Right" Content="{Binding ExportJsonText}" Command="{Binding ExportJsonCommand}"
                    ToolTip="Seçili formal modüllerin tüm nesnelerini (başlık, metin, öznitelikler) DOORS'tan okuyup tek bir JSON dosyasına yazar. Ctrl veya Shift ile birden fazla modül seçebilirsiniz." />
            <Button DockPanel.Dock="Right" Content="Listeyi CSV'ye aktar…" Command="{Binding ExportCommand}" />
            <Grid Margin="0">
                <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Ad, yol, açıklama veya ID içinde ara…" IsHitTestVisible="False"
                           Margin="12,0" VerticalAlignment="Center" Foreground="#9AA3AF">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FilterText}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DockPanel>

        <!-- Items -->
        <Grid Grid.Row="4" Margin="8,0,8,8">
            <DataGrid x:Name="ItemsGrid"
                      ItemsSource="{Binding ItemsView}"
                      SelectedItem="{Binding SelectedItem}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Extended" SelectionUnit="FullRow"
                      SelectionChanged="OnSelectionChanged"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E6E9EE" RowHeight="26"
                      BorderBrush="{StaticResource BorderBrush}"
                      MouseDoubleClick="OnItemDoubleClick">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Tam yolu kopyala" Command="{Binding CopyPathCommand}" />
                        <MenuItem Header="Bu klasörü/projeyi listele" Command="{Binding BrowseIntoCommand}" />
                        <Separator />
                        <MenuItem Header="{Binding ExportJsonText}" Command="{Binding ExportJsonCommand}" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tür" Width="120" SortMemberPath="Type"
                                        Binding="{Binding Type, Converter={StaticResource TypeLabel}}" />
                    <DataGridTextColumn Header="Ad" Width="2*" Binding="{Binding Name}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Konum" Width="3*" Binding="{Binding ParentPath}" SortMemberPath="FullName" />
                    <DataGridTextColumn Header="Açıklama" Width="2*" Binding="{Binding Description}" />
                    <DataGridTextColumn Header="Unique ID" Width="110" Binding="{Binding UniqueId}" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"
                       TextAlignment="Center" IsHitTestVisible="False"
                       Text="Henüz modül listelenmedi.&#x0a;DOORS'a bağlanın; liste otomatik olarak yüklenecek.">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Items.Count}" Value="0" />
                                    <Condition Binding="{Binding IsBusy}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <ProgressBar IsIndeterminate="True" Height="4" VerticalAlignment="Top"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
        </Grid>

        <!-- Warnings -->
        <Expander Grid.Row="5" Margin="8,0,8,8"
                  Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibility}}">
            <Expander.Header>
                <TextBlock Foreground="#9A6700">
                    <Run Text="⚠ DOORS uyarıları (" /><Run Text="{Binding Warnings.Count, Mode=OneWay}" /><Run Text=")" />
                </TextBlock>
            </Expander.Header>
            <ListBox ItemsSource="{Binding Warnings}" MaxHeight="120" BorderThickness="0" />
        </Expander>

        <!-- Status -->
        <StatusBar Grid.Row="6" Background="{StaticResource BarBrush}" BorderBrush="{StaticResource BorderBrush}"
                   BorderThickness="0,1,0,0">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel LastChildFill="True" />
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock Text="{Binding CountText}" Foreground="{StaticResource MutedBrush}" />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
