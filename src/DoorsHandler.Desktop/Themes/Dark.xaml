<!-- Dark colour palette. Keys are referenced with DynamicResource so the theme can be switched at runtime. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBrush" Color="#1E1F22" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#2B2D31" />
    <SolidColorBrush x:Key="LineBrush" Color="#3F4248" />
    <SolidColorBrush x:Key="TextBrush" Color="#E6E7EA" />
    <SolidColorBrush x:Key="MutedBrush" Color="#A0A6B0" />
    <SolidColorBrush x:Key="PlaceholderBrush" Color="#7D838D" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#6B7078" />
    <SolidColorBrush x:Key="AccentBrush" Color="#3B82D6" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#5596E0" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#2F6DB8" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ControlBrush" Color="#33363C" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#3D4148" />
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#464A52" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#4A4E56" />
    <SolidColorBrush x:Key="ControlHoverBorderBrush" Color="#666B74" />
    <SolidColorBrush x:Key="InputBrush" Color="#26282C" />
    <SolidColorBrush x:Key="PopupBrush" Color="#2B2D31" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#2F4A6E" />
    <SolidColorBrush x:Key="RowHoverBrush" Color="#2A2D33" />
    <SolidColorBrush x:Key="GridLineBrush" Color="#303338" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#4A4E56" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#5E636C" />
    <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="#3A2224" />
    <SolidColorBrush x:Key="ErrorBorderBrush" Color="#6B3438" />
    <SolidColorBrush x:Key="ErrorTextBrush" Color="#F2A7A7" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="#E3B341" />
    <SolidColorBrush x:Key="StatusOffBrush" Color="#5C626B" />
    <SolidColorBrush x:Key="StatusOnBrush" Color="#3FB971" />

    <!-- Window title bar (applied through DWM by ThemeManager; Windows 11 uses all three, Windows 10 only light/dark). -->
    <SolidColorBrush x:Key="TitleBarBrush" Color="#1E1F22" />
    <SolidColorBrush x:Key="TitleBarTextBrush" Color="#E6E7EA" />
    <SolidColorBrush x:Key="TitleBarBorderBrush" Color="#3F4248" />

    <!-- Windows system colours used by built-in templates that are not restyled. -->
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#2B2D31" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#E6E7EA" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#1E1F22" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#E6E7EA" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#2F4A6E" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#E6E7EA" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#353A42" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#E6E7EA" />
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#6B7078" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#2B2D31" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#E6E7EA" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InfoBrushKey}" Color="#2B2D31" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InfoTextBrushKey}" Color="#E6E7EA" />
</ResourceDictionary>
