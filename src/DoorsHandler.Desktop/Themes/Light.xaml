<!-- Light colour palette. Keys are referenced with DynamicResource so the theme can be switched at runtime. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#F3F5F8" />
    <SolidColorBrush x:Key="LineBrush" Color="#D5DAE1" />
    <SolidColorBrush x:Key="TextBrush" Color="#1F2328" />
    <SolidColorBrush x:Key="MutedBrush" Color="#5F6B7A" />
    <SolidColorBrush x:Key="PlaceholderBrush" Color="#9AA3AF" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#A3ABB5" />
    <SolidColorBrush x:Key="AccentBrush" Color="#1F5FAD" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#174C8C" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#123D70" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ControlBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#EEF2F7" />
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#E1E7EF" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#C3CAD4" />
    <SolidColorBrush x:Key="ControlHoverBorderBrush" Color="#9AA5B3" />
    <SolidColorBrush x:Key="InputBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PopupBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#D6E6FA" />
    <SolidColorBrush x:Key="RowHoverBrush" Color="#F2F6FB" />
    <SolidColorBrush x:Key="GridLineBrush" Color="#E6E9EE" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C3CAD4" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#A9B2BE" />
    <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="#FDF0F0" />
    <SolidColorBrush x:Key="ErrorBorderBrush" Color="#E8B4B4" />
    <SolidColorBrush x:Key="ErrorTextBrush" Color="#9B1C1C" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="#9A6700" />
    <SolidColorBrush x:Key="StatusOffBrush" Color="#B0B7C3" />
    <SolidColorBrush x:Key="StatusOnBrush" Color="#2E9D57" />

    <!-- Window title bar (applied through DWM by ThemeManager; Windows 11 uses all three, Windows 10 only light/dark). -->
    <SolidColorBrush x:Key="TitleBarBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TitleBarTextBrush" Color="#1F2328" />
    <SolidColorBrush x:Key="TitleBarBorderBrush" Color="#D5DAE1" />
</ResourceDictionary>
